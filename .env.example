# Vynexa CRM Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynexa_crm?schema=public"

# Authentication Secret
AUTH_SECRET="vynexa-crm-super-secret-key-change-in-production"

# Super Admin Privileged Credentials (Unlimited System Access)
ADMIN_EMAIL="admin@vynexa.com"
ADMIN_PASSWORD="super-secret-admin-password-change-in-production"
ADMIN_SECRET_KEY="vynexa-super-admin-bypass-key"

