# ==============================================================================
# Vynexa CRM — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development # Options: development, production, test

# Frontend Application Origin (used for CORS and redirect security)
CLIENT_URL=http://localhost:5173

# Optional: Additional CORS origins (comma-separated if multiple)
# CORS_ORIGIN=https://crm.vynexa.com

# PostgreSQL Database Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vynexa_crm?schema=public"

# Authentication Secret (JWT signing key)
# In production, this MUST be a cryptographically random string of at least 32 characters.
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-plus-character-cryptographically-secure-secret-key"

# Platform Super Admin Initial Credentials
# These credentials bootstrap platform-level super administrative oversight on initial signup.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-secure-admin-password-minimum-12-chars"

# File Storage Configuration (Optional)
# In self-hosted setups, specify the persistent storage directory path on the server:
# STORAGE_PATH=/var/lib/vynexa/uploads
# Maximum permitted document upload size in megabytes (1 to 100):
MAX_FILE_SIZE_MB=10
